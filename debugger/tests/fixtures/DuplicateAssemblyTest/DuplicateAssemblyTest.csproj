<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The plugin projects are separate compilations, not part of this one -->
  <ItemGroup>
    <Compile Remove="PluginA\**;PluginB\**" />
  </ItemGroup>

  <!-- Build ordering only — the plugins are loaded at runtime, not referenced -->
  <ItemGroup>
    <ProjectReference Include="PluginA\PluginA.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="PluginB\PluginB.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Two separately-built DLLs sharing the simple name "DupShared" (distinct MVIDs) -->
  <Target Name="CopyPluginAssemblies" AfterTargets="Build">
    <Copy SourceFiles="PluginA\bin\$(Configuration)\$(TargetFramework)\DupShared.dll"
          DestinationFiles="$(OutDir)PluginA\DupShared.dll" />
    <Copy SourceFiles="PluginB\bin\$(Configuration)\$(TargetFramework)\DupShared.dll"
          DestinationFiles="$(OutDir)PluginB\DupShared.dll" />
  </Target>

</Project>
